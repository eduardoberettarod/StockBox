{
  "expo": {
    "name": "StockBox",
    "slug": "StockBox",
    "scheme": "stockbox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e0d0d",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.StockBox"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "./plugins/with-android-ndk-path",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O StockBox precisa acessar suas fotos para escolher a imagem do produto.",
          "cameraPermission": "O StockBox precisa acessar a câmera para tirar a foto do produto."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "O StockBox precisa acessar suas fotos para usar a imagem do produto.",
          "savePhotosPermission": "O StockBox precisa salvar a foto tirada do produto na sua galeria.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ]
  }
}
